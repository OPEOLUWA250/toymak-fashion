# Copy this file to .env.local (already gitignored) and fill in your real values.
# Use "Test Mode" / sandbox keys for everything while developing.

# --- Paystack — Dashboard -> Settings -> API Keys & Webhooks. ---
# Secret key — server-only, never exposed to the browser. Used by the
# app/api/paystack/* route handlers to initialize and verify transactions.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# --- Stripe — Dashboard -> Developers -> API keys. ---
# Secret key — server-only, never exposed to the browser. Used by the
# app/api/stripe/* route handlers to create and verify Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# --- Stripe webhook secret ---
# Verifies that POST /api/stripe/webhook really came from Stripe. To test
# locally: install the Stripe CLI, run `stripe login` once, then keep this
# running in a terminal while you dev:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# It prints a `whsec_...` value — paste that here. In production, create a
# webhook endpoint in the Stripe dashboard pointing at your real domain and
# use the signing secret it gives you instead.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Paystack's webhook (POST /api/paystack/webhook) reuses PAYSTACK_SECRET_KEY
# above for signature verification — no separate secret needed. To test it
# locally, Paystack's servers need a public URL to call, so tunnel your
# dev server (e.g. `ngrok http 3000`) and set that ngrok URL + /api/paystack/webhook
# as the webhook URL in the Paystack dashboard -> Settings -> API Keys & Webhooks.

# --- Resend — https://resend.com/api-keys ---
# Sends the discount-code email when someone submits the homepage popup.
RESEND_API_KEY=re_your_resend_api_key
# Optional — defaults to Resend's built-in test sender if omitted. That
# sender (onboarding@resend.dev) can only deliver to the email address you
# signed up to Resend with. To email real customers, verify your own domain
# in Resend (Domains -> Add Domain) and set this to an address on it, e.g.
# "Toymak <hello@toymak.com>".
RESEND_FROM_EMAIL=Toymak <onboarding@resend.dev>
